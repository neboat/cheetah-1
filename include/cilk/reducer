// __hyper_lookup_class_static(const cilk::reducer_base *, size_t size,
//                             cilk::rb_identity_fn ident_fn,
//                             cilk::rb_reduce_fn red_fn)
//     __attribute__((nonnull, returns_nonnull));

extern "C" void *__hyper_lookup_internal_1(void *, const cilk::reducer_callbacks &)
  __attribute__((nonnull, returns_nonnull));

#endif // _CILK_REDUCER_
