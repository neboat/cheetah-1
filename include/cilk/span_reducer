namespace {
constexpr size_t next_multiple(size_t val, size_t multiple) {
    return ((val + multiple - 1) / multiple) * multiple;
}
} // namespace

namespace cilk {

template <typename T> using span_element_identity_fn = void (*)(T &);
template <typename T> using span_element_reduce_fn = void (*)(T &, const T &);

