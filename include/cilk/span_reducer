template <typename T, span_element_identity_fn<T> el_id_fn,
          span_element_reduce_fn<T> el_reduce_fn>
class span_reducer_base
    : public cilk::ReducerBase<span_reducer_base<T, el_id_fn, el_reduce_fn>>,
      public std::span<T> {
  public:
    using size_type = std::span<T>::size_type;

    // Export similar constructors as std::span.
    // TODO: Export more constructors.
    template <class It>
    constexpr span_reducer_base(It first, size_type count)
        : std::span<T>(first, count) {}
    template <class R> constexpr span_reducer_base(R &&r) : std::span<T>(r) {}
    constexpr span_reducer_base(const std::span<T> &base)
        : std::span<T>(base) {}

  public:
    size_t view_size() const {
        return next_multiple(sizeof(span_reducer_base) + this->size_bytes(),
                             sizeof(T));
    }
    reducer_base *identity(void *v) {
        // Create a new view backed by an array of the right size.
        // auto *array = new T[this->size()];
        auto *array = reinterpret_cast<T *>(
            static_cast<std::byte *>(v) +
            next_multiple(sizeof(span_reducer_base), sizeof(T)));
        auto *res = new (v) span_reducer_base(array, this->size());

        // Initialize all array elements to the identity value.
        for (size_type i = 0; i < this->size(); ++i) {
            el_id_fn(array[i]);
        }
        return res;
    }
    void reduce(reducer_base *l, reducer_base *r) {
        auto *lv = static_cast<span_reducer_base *>(l);
        auto *rv = static_cast<span_reducer_base *>(r);

        assert(lv->size() == rv->size());

        size_type count = rv->size();
        // Reduce each element of the left and right views.
        for (size_type i = 0; i < count; ++i) {
            el_reduce_fn((*lv)[i], (*rv)[i]);
        }
        // // Delete the array backing the right view.
        // delete[] rv->data();
    }
};

template <typename T> void el_zero(T &v) { v = 0; }
template <typename T> void el_plus(T &l, const T &r) { l += r; }

template <typename T, span_element_identity_fn<T> el_id_fn,
          span_element_reduce_fn<T> el_reduce_fn>
using span_reducer = span_reducer_base<T, el_id_fn, el_reduce_fn> cilk_reducer;

// A span sum reducer is a span reducer that uses the zero-plus monoid on each
// element.
template <typename T>
using span_sum_reducer =
    span_reducer_base<T, el_zero<T>, el_plus<T>> cilk_reducer;

